[Unit]
Description=EXP Operations standard queue worker
Wants=network-online.target
After=network-online.target mariadb.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/exp-operations
ExecStart=/usr/bin/php8.3 /var/www/exp-operations/artisan queue:work --sleep=3 --tries=3 --timeout=60 --max-time=3600 --no-interaction
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=90s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exp-queue-worker

[Install]
WantedBy=multi-user.target
