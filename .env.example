APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

EXP_PBX_NAME="VitalPBX EXP"
EXP_PBX_HOST=
EXP_PBX_AMI_PORT=5038
EXP_PBX_AMI_USERNAME=
EXP_PBX_AMI_PASSWORD=
EXP_PBX_AMI_TIMEOUT=10
EXP_SCREENING_EXTENSION=204
EXP_LIVE_REFRESH_SECONDS=3
EXP_AMI_HEARTBEAT_STALE_SECONDS=90

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 3: comma-separated approved entry identifiers (no spaces). Wildcards are
# allowed in the context lists, for example IVR-* for VitalPBX IVR modules.
# Leave both context variables empty to use the VitalPBX defaults
# (incoming-calls and IVR-*,app-ivr,app-announcement).
EXP_PBX_INBOUND_DIDS=0596921095
EXP_PBX_INBOUND_CONTEXTS=
EXP_PBX_IVR_CONTEXTS=
EXP_PBX_RECONCILIATION_TOLERANCE_SECONDS=2

# The listener must keep up with the PBX event burst to stay connected.
# Noise events are dropped before storage; per-event logs stay off unless a
# call trace is being investigated.
EXP_PBX_HEARTBEAT_INTERVAL_SECONDS=20
EXP_PBX_HEARTBEAT_TIMEOUT_SECONDS=45
EXP_PBX_PRUNE_INTERVAL_SECONDS=60
EXP_PBX_LOG_EACH_EVENT=false
# Comma-separated AMI events that carry no journey evidence. Wildcards are
# allowed. Leave empty to use the built-in list (VarSet, RTCP*, ContactStatus,
# ExtensionStatus, DeviceStateChange, QueueMemberStatus, MessageWaiting,
# HangupHandler*, SoftHangupRequest, NewConnectedLine, MusicOnHold*,
# FullyBooted, Reload, NewAccountCode, DTMFBegin).
EXP_PBX_IGNORED_EVENTS=

# Phase 4: live dashboard thresholds. The listener lock file is optional; leave
# empty to use storage/framework/exp-ami-listener.lock.
EXP_AMI_LISTENER_LOCK_PATH=
EXP_LONG_RINGING_SECONDS=45
EXP_ALERT_LOOKBACK_MINUTES=1440
EXP_AGENT_PRESENCE_WINDOW_MINUTES=10

# Phase 5: dentist directory matching. Unmatched dialled destinations are
# reported for this many days; performance rolls up over its own window.
EXP_DENTIST_UNMATCHED_LOOKBACK_DAYS=7
EXP_DENTIST_PERFORMANCE_WINDOW_DAYS=30

# Inbound IVR tree. Option 3 is the only option that reaches an agent; the
# labels must match the recordings callers hear.
EXP_IVR_AGENT_OPTION=3
EXP_IVR_USER_EVENT=

# Published service window (Ghana timezone, Monday–Friday). Rosters and the
# public call screens both read these values.
EXP_SERVICE_TIMEZONE=Africa/Accra
EXP_SERVICE_OPENS_AT=10:00
EXP_SERVICE_CLOSES_AT=14:00

# Separate call-control gateway; keep disabled until PBX lab approval.
EXP_CALL_CONTROL_ENABLED=false
EXP_CALL_CONTROL_LAB_APPROVED=false
EXP_CALL_CONTROL_URL=
EXP_CALL_CONTROL_TOKEN=
EXP_CALL_CONTROL_IDENTITY=

# Phase 6: operational reports. The consultation tariff powers the estimated
# cost KPI only; leave at 0 until the service owner approves one. Manual report
# windows are bounded so no single request can scan the whole call archive.
REPORTING_CONSULTATION_TARIFF_PER_MINUTE=0
REPORTING_MAX_WINDOW_DAYS=92
